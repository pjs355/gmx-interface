{
	"name": "levelup-predictions",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "yarn@3.1.0",
	"scripts": {
		"dev": "tsx scripts/dev-prompt.ts",
		"dev:clean": "rm -rf node_modules/.vite && vite",
		"dev:clean:local": "rm -rf node_modules/.vite && VITE_ENVIRONMENT_MODE=local vite",
		"dev:live": "VITE_ENVIRONMENT_MODE=production vite",
		"dev:local": "VITE_ENVIRONMENT_MODE=local vite",
		"build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vite build",
		"build:production": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vite build --mode sourcemaps && yarn upload-sourcemaps",
		"upload-sourcemaps": "sentry-cli sourcemaps upload --org prinx --project levelup-interface --release ${RAILWAY_GIT_COMMIT_SHA:-local} ./dist",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build:strict": "yarn typecheck && yarn format:check && yarn lint:strict && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vite build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
		"lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "tsx scripts/preview-prompt.ts",
		"preview:serve": "vite preview",
		"preview:live": "VITE_ENVIRONMENT_MODE=production yarn build && yarn preview:serve",
		"preview:local": "VITE_ENVIRONMENT_MODE=local yarn build && yarn preview:serve",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test --config e2e/playwright.config.ts",
		"e2e:report": "playwright show-report e2e/playwright-report",
		"e2e:seed-profile": "tsx e2e/scripts/seed-profile.ts",
		"predeploy": "tsx scripts/predeploy.ts",
		"predeploy:bootstrap": "tsx scripts/predeploy.ts --bootstrap"
	},
	"dependencies": {
		"@floating-ui/react": "^0.27.16",
		"@headlessui/react": "^2.2.9",
		"@limitless-exchange/sdk": "^1.0.6",
		"@lingui/core": "4.10.0",
		"@lingui/macro": "4.11.3",
		"@lingui/react": "4.10.0",
		"@noble/curves": "1.6.0",
		"@noble/hashes": "1.5.0",
		"@polymarket/builder-relayer-client": "^0.0.9",
		"@polymarket/builder-signing-sdk": "^1.0.0",
		"@polymarket/clob-client-v2": "1.0.3-canary.0",
		"@predictdotfun/sdk": "^1.3.0",
		"@privy-io/react-auth": "^3.32.0",
		"@sentry/react": "^10.22.0",
		"@sentry/vite-plugin": "^4.6.0",
		"@solana-program/memo": "^0.8.0",
		"@solana-program/system": "^0.8.0",
		"@solana-program/token": "^0.6.0",
		"@solana/kit": "^3.0.3",
		"@solana/spl-token": "^0.4.14",
		"@solana/web3.js": "^1.98.4",
		"@stripe/crypto": "^1.1.0",
		"@stripe/stripe-js": "^1.46.0",
		"@tanstack/react-query": "^5.90.2",
		"@types/lodash": "^4.17.20",
		"bowser": "^2.12.1",
		"bs58": "^6.0.0",
		"buffer": "^6.0.3",
		"classnames": "^2.3.2",
		"date-fns": "^4.1.0",
		"ethers": "^6.8.1",
		"ethers5": "npm:ethers@5.7.2",
		"firebase": "^12.3.0",
		"gray-matter": "^4.0.3",
		"lodash": "^4.17.21",
		"marked": "^18.0.5",
		"mixpanel-browser": "^2.72.0",
		"permissionless": "^0.2.57",
		"process": "^0.11.10",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-helmet": "^6.1.0",
		"react-icons": "^5.5.0",
		"react-remove-scroll": "^2.7.1",
		"react-router-dom": "^6.20.1",
		"react-toastify": "^9.1.3",
		"react-use": "^17.4.0",
		"recharts": "^2.8.0",
		"swr": "^2.2.4",
		"viem": "^2.28.1"
	},
	"devDependencies": {
		"@lingui/babel-plugin-lingui-macro": "^5.5.0",
		"@lingui/cli": "4.10.0",
		"@lingui/vite-plugin": "4.11.3",
		"@playwright/test": "^1.59.1",
		"@testing-library/react": "^14.0.0",
		"@types/marked": "^6.0.0",
		"@types/react": "^18.2.37",
		"@types/react-dom": "^18.2.15",
		"@typescript-eslint/eslint-plugin": "^6.10.0",
		"@typescript-eslint/parser": "^6.10.0",
		"@vitejs/plugin-react": "^4.1.1",
		"babel-plugin-macros": "^3.1.0",
		"baseline-browser-mapping": "^2.8.32",
		"eslint": "^8.53.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-refresh": "^0.4.4",
		"jsdom": "^24.0.0",
		"prettier": "^3.4.2",
		"sass": "^1.69.5",
		"tsx": "^4.19.3",
		"typescript": "^5.2.2",
		"vite": "^4.5.0",
		"vite-plugin-node-polyfills": "^0.26.0",
		"vitest": "^1.6.0"
	},
	"engines": {
		"node": ">=20"
	}
}
