GENERATE_SOURCEMAP=false
# yarn dev → [3] sets VITE_PREDICTION_API_BASE_URL=http://localhost:8080 for this session (unified local API).
# To force Railway catalogs while keeping [3] contracts, run `npx vite` with VITE_ENVIRONMENT_MODE=local-production
# or uncomment and set a different URL here (overridden by [3] when using yarn dev):
# VITE_PREDICTION_API_BASE_URL=http://localhost:8080
# Optional: keep private routes on same host (usually already localhost in local-production):
# VITE_PRIVATE_API_BASE=http://localhost:8080
# Bare `vite` without the prompt defaults to testnet (localhost:8080). Either run `yarn dev` and pick 3, or set:
# VITE_ENVIRONMENT_MODE=local-production
# Optional: force prediction API to Railway when you want live catalogs but had set localhost above:
# VITE_PREDICTION_API_BASE_URL=https://prediction-api-production.up.railway.app
# Optional; defaults to public Polygon RPC. For production rate limits use Infura/Alchemy:
# VITE_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
VITE_APP_UI_FEE_RECEIVER=0xff00000000000000000000000000000000000001
VITE_PRIVY_APP_ID=cmb7ccvbd011hl50m62vf8epr

# Polymarket CLOB proxy — routes through Railway to bypass US geo-block.
# Enabled interactively via `yarn dev` → "Use Railway proxy? (y/n)"
VITE_POLY_PROXY_URL=https://patriotic-sheepdog.up.railway.app/proxy
VITE_POLY_PROXY_TOKEN=poly-proxy-secret-token-change-me

# Venue-prices WebSocket base only (path /ws/venue-prices appended). Optional if VITE_PREDICTION_API_BASE_URL
# already points at your API — then venue WS follows the same host. Uncomment to force a specific WS origin:
# VITE_ODDS_WS_BASE=ws://localhost:8080

# Verbose pricing / venue logs + WebSocket diagnostics HUD (dev)
VITE_DEBUG_PREDICTION_PRICING=1
